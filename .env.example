# Example only — configure the actual Hostinger MySQL/MariaDB connection securely.
# Do not commit or share your real password. URL-encode special characters in credentials.
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME"

# Enables ONLY the isolated /pilot page and /api/pilot endpoints.
# The main browser-local demo remains blocked in production.
ENABLE_PILOT="false"
